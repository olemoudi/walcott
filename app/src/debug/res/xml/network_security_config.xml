<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Permits cleartext to a local stand-in for the sync server, which is the
  only way to exercise a parent -> child exchange on a single emulator on demand.

  Two addresses, for two ways of reaching the same host machine:
    - 10.0.2.2 is the emulator's host loopback, over its emulated network interface.
    - 127.0.0.1 is for `adb reverse`, which tunnels the port over the adb transport instead.
      That matters more than it sounds: the emulated Wi-Fi interface disappears from the guest
      kernel under a long run, and when it does every socket fails while adb keeps working. A
      harness that goes through loopback is simply not exposed to that.

  Everything else keeps the platform default (cleartext refused). Release builds do not contain
  this file, so the real channel stays HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
