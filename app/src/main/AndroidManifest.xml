<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Allow all the time": needed so the Device Owner can force-grant background location and
         tracking keeps working when Walcott isn't in the foreground. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The periodic location fix and close-tracking sessions hold the CPU awake while a fix is
         acquired. Without it the SoC suspends the moment the alarm's receiver returns, which is
         the very hole that made the old timer-driven sampling drift (see LocationAlarm). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Declared here rather than inherited through manifest merge: the sync socket depends on
         it to reconnect the moment coverage returns (see SyncManager.watchNetwork), and a
         permission that arrives by accident from a dependency can leave by accident too. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the emergency release (PanicRelease) offer the system uninstall prompt for
         Walcott itself; without it the prompt is refused and the button does nothing. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- osmdroid can pull this in via manifest merge; we cache tiles in app-private storage,
         so strip it to keep the permission set minimal (no-op if no library declares it). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- allowBackup off: the DataStore holds the family sync key and the parent-PIN hash;
         cloud backup or device-to-device transfer would hand both to whoever controls the
         child's Google account. Pairing is device-bound anyway, so backups have no value. -->
    <application
        android:name=".WalcottApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Walcott">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Walcott">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Play share target: the parent shares an app from Play Store into Walcott to push an
             assisted install to a child. Its own task, finishes after sending. -->
        <activity
            android:name=".install.ShareInstallActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/install_share_label"
            android:theme="@style/Theme.Walcott">
            <intent-filter android:label="@string/install_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Tap target for a parent-pushed install (notification / child-home card): re-opens
             the tight install window at tap time, then forwards to the app's Play page. -->
        <activity
            android:name=".install.InstallPromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Modern (API 29+) Device Owner provisioning handshake driven by the setup wizard after
             it installs Walcott from the QR. BIND_DEVICE_ADMIN restricts launch to the system. -->
        <activity
            android:name=".provisioning.ProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@style/Theme.Walcott">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".enforcement.EnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_control_enforcement" />
        </service>

        <service
            android:name=".enforcement.AppBlockerService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!--
            The notification log (see NotificationLog). Bound by the system only once the phone's
            owner enables it in Settings — there is no way for a Device Owner to grant it — and it
            records nothing unless the family's rules ask for it.
        -->
        <service
            android:name=".notifications.WalcottNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".net.WalcottVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".enforcement.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- The child's ~30-minute check-in alarm (see HeartbeatAlarm). -->
        <receiver
            android:name=".sync.HeartbeatReceiver"
            android:exported="false" />

        <!-- The nightly hour in which a blocked phone may update what it has installed
             (see AppUpdateWindowAlarm). An alarm because it has to fire while asleep, plus the
             clock broadcasts: the alarm is an absolute instant computed from a local hour, so a
             family that flies east has 4am armed in the timezone they left. -->
        <receiver
            android:name=".enforcement.AppUpdateWindowReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Puts the install block back when the window that lifted it runs out
             (see InstallBlockAlarm). An alarm, because those windows end on a sleeping phone. -->
        <receiver
            android:name=".enforcement.InstallBlockReceiver"
            android:exported="false" />

        <!-- The child's periodic location fix (see LocationAlarm). An alarm rather than an
             in-process timer, because a timer does not tick while the device is asleep. -->
        <receiver
            android:name=".location.LocationSampleReceiver"
            android:exported="false" />

        <!-- The parent's catch-up alarm (see ParentCheckAlarm): WorkManager alone is deferred by
             Doze for hours, which is when nobody is watching the socket either. Its interval is
             10 or 30 minutes depending on whether any child is alive to ask (ParentCadence). -->
        <receiver
            android:name=".sync.ParentCheckReceiver"
            android:exported="false" />

        <receiver
            android:name=".WalcottAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- "Don't remind me again" action on the backup-reminder notification. -->
        <receiver
            android:name=".sync.BackupReminderReceiver"
            android:exported="false" />

        <!-- "Refuse" action on the child's emergency-release alert (see PanicProtocol). -->
        <receiver
            android:name=".sync.PanicDenyReceiver"
            android:exported="false" />

        <!-- Approve/Deny actions on a child's request notification. -->
        <receiver
            android:name=".sync.RequestActionReceiver"
            android:exported="false" />

        <!-- "Re-block now" action on the open-install-window reminder. -->
        <receiver
            android:name=".sync.InstallReminderReceiver"
            android:exported="false" />

        <!-- Remove/Allow actions on the "an app appeared unapproved" alert. -->
        <receiver
            android:name=".sync.UnauthorizedAppReceiver"
            android:exported="false" />

        <!-- Hands the encrypted family backup to the share sheet (email-to-self and the like). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
